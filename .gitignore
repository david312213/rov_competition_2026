# macOS / 编辑器临时文件
.DS_Store

# Python 与 ROS 2 构建产物
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
output/
/RELEASE_MANIFEST.json

# 每台实艇独有的配置与现场备份，不得提交到公共历史
config/robot.yaml
config/robot.yaml.*
config/robot_old_reference.yaml
config/dataset.yaml
ros2_ws/src/rov_competition/config/robot.yaml
*.local.yaml

# 训练权重超过 GitHub 普通文件上限，保留在各机器本地
ros2_ws/src/rov_competition/models/*.pt
ros2_ws/src/rov_competition/models/*.onnx
ros2_ws/src/rov_competition/models/*.engine

# 现场数据、录像与发布压缩包
*.bag
*.db3
*.mcap
*.mp4
*.zip
*.log
!tests/fixtures/*.log
